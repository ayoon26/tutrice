# Copy to .env.local and fill in whichever integrations you're ready to turn on.
# Every integration below degrades to a clearly-labeled mock when its
# variables are absent, so the app runs end-to-end with none of this set.

# ── Supabase (database, auth, storage) ──────────────────────────────────
# Without these, the app runs against a single-process in-memory store: one
# shared "demo tutor" account, no login screen, data resets on server restart.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed for the Google OAuth callback and lesson-audio storage
# to write before a session cookie exists. Falls back to the anon key if unset.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Calendar OAuth ────────────────────────────────────────────────
# Without these, onboarding skips straight to a mocked calendar scan
# (Sarah Kim / Daniel Lee / a false-positive "Dentist" event).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application) with the Calendar API enabled, scope
# https://www.googleapis.com/auth/calendar.readonly, and this redirect URI:
#   http://localhost:3000/api/calendar/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI memory extraction (Google Gemini) ─────────────────────────────────
# Without this, lesson reviews and pasted-message reviews fall back to fixed
# sample suggestions instead of real Gemini-extracted ones. Get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Speech-to-text (OpenAI Whisper) ──────────────────────────────────────
# Without this, lesson recordings transcribe to a fixed sample transcript
# instead of the real audio.
OPENAI_API_KEY=
